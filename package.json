{
  "name": "opencode-cross-session-messaging",
  "version": "0.1.0",
  "description": "OpenCode plugin for cross-session messaging — local file IPC or cross-device relay via WebSocket. Sessions discover, ask, and reply across machines.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinminghao/cross-session-messaging.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "multi-agent",
    "cross-session",
    "cross-device",
    "relay",
    "messaging"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./tui": {
      "import": "./tui.tsx"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "tui.tsx",
    "README.md",
    "README.zh-CN.md",
    "SKILL.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=1.3.13",
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.4",
    "@opentui/solid": "^0.4.1",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "typescript": "^5.9.3"
  }
}
